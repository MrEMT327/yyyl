{
  "name": "thunder-vector",
  "version": "0.1.50",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:sfx": "node tools/generate-combat-sfx.mjs",
    "assets:wechat-audio": "node wechat/tools/prepare-audio.mjs",
    "dev": "vite",
    "dev:wechat": "npm run build:wechat",
    "prebuild": "npm run check:player-state && node tools/audit-replica-snapshot.mjs && node tools/check-original-ui-art.mjs && node tools/generate-native-economy.mjs --check && node tools/generate-native-weapon-preview.mjs --check && node tools/generate-native-equipment-effects.mjs --check",
    "build": "vite build",
    "prebuild:economy": "npm run check:player-state && node tools/check-original-ui-art.mjs",
    "build:economy": "vite build --mode economy --outDir dist-economy",
    "preview:economy": "vite preview --outDir dist-economy --host 0.0.0.0 --port 4174 --strictPort",
    "prebuild:zh": "npm run check:player-state && node tools/check-original-ui-art.mjs",
    "build:zh": "vite build --mode zh",
    "prebuild:4399": "npm run check:player-state && node tools/check-original-ui-art.mjs",
    "build:4399": "vite build --mode 4399",
    "package:zh": "node tools/package-zh-release.mjs",
    "package:zh:obfuscated": "npm run build:zh && node tools/package-zh-obfuscated-release.mjs",
    "package:4399": "npm run build:4399 && node tools/package-4399-release.mjs",
    "prebuild:wechat": "npm run check:player-state && node tools/check-original-ui-art.mjs",
    "build:wechat": "node wechat/tools/build.mjs",
    "verify:wechat": "node wechat/tools/verify-build.mjs",
    "test": "node --test",
    "test:web": "node tools/run-web-checks.mjs",
    "test:performance": "node --test tests/performance-regressions.test.js tests/static-files.test.js tests/ui-performance.test.js tests/renderer-metrics.test.js tests/ui-draw-budget.test.js",
    "perf:simulate": "node tools/benchmark-common-combat.mjs",
    "perf:server": "node tools/benchmark-static-server.mjs",
    "preview": "vite preview",
    "lan": "npm run build && node server/lan-server.js",
    "balance:check": "node tools/balance/import-balance.mjs --check",
    "balance:import": "node tools/balance/import-balance.mjs",
    "balance:simulate": "node tools/balance/simulate-balance.mjs",
    "test:wechat-ui": "node --test tests/wechat-platform.test.js tests/wechat-webassembly.test.js tests/wechat-queue-microtask.test.js tests/wechat-url-search-params.test.js tests/wechat-audio.test.js tests/wechat-canvas-ui.test.js tests/wechat-rewarded-ad.test.js tests/wechat-touch-router.test.js",
    "check:player-state": "node tools/check-player-state.mjs",
    "check:replica-types": "tsc --noEmit -p replica-battle/tsconfig.json",
    "check:replica-snapshot": "node tools/audit-replica-snapshot.mjs",
    "check:replica-economy": "node tools/generate-native-economy.mjs --check",
    "qa:wechat": "node wechat/tools/preview-server.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "yoga-layout": "3.2.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "linkedom": "0.18.14",
    "exceljs": "^4.4.0",
    "javascript-obfuscator": "^5.5.0",
    "jszip": "^3.10.1",
    "vite": "^7.0.0",
    "typescript": "5.9.3"
  }
}
