!/pixigame/tools/package-zh-obfuscated-release.mjs
!/pixigame/tools/package-4399-release.mjs
!/pixigame/tools/balance/
/pixigame/tools/balance/*
!/pixigame/tools/balance/import-balance.mjs

/pixigame/public/prototypes/
/pixigame/public/**/*.md
