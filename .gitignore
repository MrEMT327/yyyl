# 阶段 01 原版基线构建，仅本地验证使用。
.baseline-build/
.DS_Store

# Dependencies, build artifacts and local caches.
node_modules/
dist/
dist-wechat/
pixigame/wechat/config.local.json
.cache/
.vite/
coverage/
*.tsbuildinfo

# Local outputs and temporary files.
output/
outputs/
tmp/
.tmp/
.tmp-*/
*.tmp
*.temp
*.swp
*.swo
~$*

# Logs and test reports.
logs/
*.log
*.log.*
playwright-report/
test-results/

# Local environment configuration; keep templates versioned.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 本地设计资料、独立演示项目及美术源文件（保留在本地，不上传 Git）。
/doc/
/demoh5/
/psd/
/立绘new/
/拆解/*.apk

# 本地浏览器自动化输出、测试证据和未接入的美术变体（保留在本地，不提交）
.playwright-cli/
/pixigame/art/archive/
/pixigame/art/project-research-draw-v3/
/pixigame/art/project-research-draw-anime-v4/
/pixigame/art/skill-icons-anime-v1/
/pixigame/art/skill-icons-anime-v1.zip
/pixigame/public/art/project-research-draw-v3/
/pixigame/public/art/project-research-draw-anime-v4/

# 仅提交核心工程；测试、QA、研究资料和制作原件留在本地。
/HANDOFF.md
/design-qa.md
/pixigame/design-qa.md
/pixigame/tests/
/pixigame/**/__tests__/
/pixigame/**/*.test.*
/pixigame/**/*.spec.*
/pixigame/doc/
/pixigame/docs/
/pixigame/art/**
/pixigame/art-source/
# 正式构建需要的原创素材来源与 PSD 保护索引。
